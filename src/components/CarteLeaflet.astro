---
import "leaflet/dist/leaflet.css";
---

<figure>
  <div
    id="map"
    role="region"
    aria-label="Carte interactive des établissements en France"
  ></div>

  <figcaption>
    Figure 2. Localisation des établissements en France.
    Cliquez sur un marqueur pour afficher le nom de l'établissement.
  </figcaption>
</figure>

<script>
  import L from "leaflet";
  import listeEtablissements from "../assets/listeEtablissements.json";

  // 1. Création de la carte centrée sur la France
  const map = L.map("map").setView([46.6033, 1.883], 6);

  // 2. Ajout du fond de carte OpenStreetMap
  L.tileLayer(
    "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 19
    }
  ).addTo(map);

  // 3. Icône des marqueurs Leaflet
  const icone = L.icon({
    iconUrl:
      "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png",
    shadowUrl:
      "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34],
    shadowSize: [41, 41]
  });

  // 4. Affichage des établissements
  listeEtablissements.forEach((etablissement) => {
    const latitude = Number(etablissement.lat);
    const longitude = Number(etablissement.lon);

    // Vérifier que les coordonnées sont valides
    if (
      !Number.isFinite(latitude) ||
      !Number.isFinite(longitude) ||
      Math.abs(latitude) > 90 ||
      Math.abs(longitude) > 180
    ) {
      return;
    }

    // Création d'un marqueur
    const marker = L.marker(
      [latitude, longitude],
      { icon: icone }
    ).addTo(map);

    // Fenêtre d'information au clic
    const contenu = document.createElement("strong");
    contenu.textContent = etablissement.name || "Établissement";

    marker.bindPopup(contenu);
  });
</script>

<style>
  #map {
    height: 600px;
    width: 100%;
    border-radius: 12px;
    z-index: 0;
  }

  figure {
    margin: 20px 0;
  }

  figcaption {
    margin-top: 12px;
    font-size: 0.9rem;
    color: #555;
  }
</style>
