---
import Layout from "../layouts/Layout.astro";

import PlotFigure from "../components/PlotFigure.astro";
import CarteLeaflet from "../components/CarteLeaflet.astro";
import CarteGeoJSON from "../components/CarteGeoJSON.astro";

import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout>
  <main>
    <h1>TP7 - Visualisation de données</h1>

    <p class="introduction">
      Visualisation de données avec Astro,
      Observable Plot, Leaflet et GeoJSON.
    </p>

    <!-- CONSIGNE 0 : ACCESSIBILITÉ -->
    <section aria-labelledby="titre-penguins">

      <h2 id="titre-penguins">
        1. Analyse des manchots
      </h2>

      <p>
        Ce graphique présente les caractéristiques
        morphologiques des manchots selon leur espèce.
      </p>

      <PlotFigure
        options={{
          title: "Morphologie des manchots",

          subtitle:
            "Longueur et profondeur du bec selon l'espèce",

          caption:
            "Figure 1. Chaque point représente un manchot. Les couleurs distinguent les espèces.",

          ariaLabel:
            "Nuage de points représentant les dimensions du bec des manchots",

          ariaDescription:
            "La longueur du bec est représentée sur l'axe horizontal et sa profondeur sur l'axe vertical, en millimètres.",

          x: {
            label: "Longueur du bec (mm)"
          },

          y: {
            label: "Profondeur du bec (mm)"
          },

          color: {
            legend: true,
            label: "Espèce"
          },

          marks: [
            Plot.frame(),

            Plot.dot(penguins, {
              x: "culmen_length_mm",
              y: "culmen_depth_mm",
              stroke: "species",
              tip: true
            })
          ]
        }}
      />

    </section>

    <!-- CONSIGNE 1 : LEAFLET -->
    <section aria-labelledby="titre-leaflet">

      <h2 id="titre-leaflet">
        2. Carte des établissements
      </h2>

      <p>
        Cette carte interactive présente la localisation
        des établissements en France.

        Cliquez sur les marqueurs pour afficher le nom
        des établissements.
      </p>

      <CarteLeaflet />

    </section>

    <!-- CONSIGNE 2 : GEOJSON -->
    <section aria-labelledby="titre-geojson">

      <h2 id="titre-geojson">
        3. Population par département
      </h2>

      <p>
        Cette carte GeoJSON présente les populations
        des départements français.

        Les trois menus déroulants permettent de
        sélectionner une année, un sexe et une catégorie
        d'âge.
      </p>

      <CarteGeoJSON />

    </section>
  </main>
</Layout>

<style>
  .introduction {
    text-align: center;
    margin-bottom: 50px;
    color: #555;
  }

  section {
    margin-bottom: 70px;
    padding-bottom: 40px;
    border-bottom: 1px solid #ddd;
  }

  h2 {
    margin-bottom: 15px;
  }

  p {
    line-height: 1.7;
  }
</style>
